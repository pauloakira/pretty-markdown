@startuml sequence-open-document
title pretty-markdown — Open a document in a new tab (with math fallback)

actor User
participant "TabBar\n(Presentation)" as TabBar
participant "TabManager\n(Application)" as TabMgr
participant "DocumentService\n(Application)" as DocSvc
participant "FsAdapter (Tauri)\n(Infrastructure)" as Fs
participant "MarkdownPipeline\n(markdown-it)" as MD
participant "MathRenderer\n(Composite)" as Math
participant "KaTeX" as KaTeX
participant "MathJax" as MathJax
participant "Reader View\n(Presentation)" as Reader

User -> TabBar : open file / ⌘T
activate TabBar
TabBar -> TabMgr : openInNewTab(path)
activate TabMgr

TabMgr -> DocSvc : load(path)
activate DocSvc
DocSvc -> Fs : readFile(path)
activate Fs
Fs --> DocSvc : markdown source
deactivate Fs
DocSvc --> TabMgr : Document
deactivate DocSvc

TabMgr -> TabMgr : create Tab(document, viewState)
TabMgr -> TabMgr : setActive(tab)
TabMgr --> TabBar : tab created + activated
deactivate TabMgr
TabBar -> Reader : mount(activeTab)
deactivate TabBar
activate Reader

Reader -> MD : parse(source)
activate MD
MD --> Reader : AST (markdown + math tokens)
deactivate MD

loop for each math token
  Reader -> Math : render(tex, {display})
  activate Math
  Math -> KaTeX : render(tex)
  activate KaTeX
  alt KaTeX succeeds
    KaTeX --> Math : html
  else ParseError
    KaTeX --> Math : error
    deactivate KaTeX
    Math -> MathJax : render(tex)
    activate MathJax
    alt MathJax succeeds
      MathJax --> Math : html
    else still fails
      MathJax --> Math : error
    end
    deactivate MathJax
  end
  Math --> Reader : RenderResult (html | error chip)
  deactivate Math
end

Reader -> Reader : compose blocks + cache (per tab)
Reader --> User : rendered document
deactivate Reader

@enduml
